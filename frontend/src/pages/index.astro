---
import BankingApp from '../components/BankingApp';
import '@fontsource-variable/inter';
import '@fontsource-variable/manrope';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Manage your savings and track account activity with HDFC Bank, an independent student project using virtual funds." />
    <meta name="theme-color" content="#f8f9fc" />
    <link rel="icon" href="/mark.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href="https://hdfc-bank-web.onrender.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="HDFC Bank | Digital banking" />
    <meta property="og:description" content="A clear view of your savings. An independent student project using virtual funds." />
    <meta property="og:url" content="https://hdfc-bank-web.onrender.com/" />
    <meta property="og:image" content="https://hdfc-bank-web.onrender.com/social-card-v2.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="HDFC Bank. Your savings, always in view." />
    <meta name="twitter:card" content="summary_large_image" />
    <title>HDFC Bank | Digital banking</title>
  </head>
  <body><BankingApp client:load /><noscript><p class="wrap">Enable JavaScript to sign in and use your account.</p></noscript><script>import '../lib/platform';</script></body>
</html>
