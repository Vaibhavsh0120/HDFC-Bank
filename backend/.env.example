# Django application settings
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# MySQL connection; local-run supplies its own local settings.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bank
DB_USER=bank
DB_PASSWORD=replace-me
DB_SSL_CA=
DB_SSL_CA_BASE64=

# Used only when provisioning an administrator.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=

# Google web OAuth client ID and project identifier.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLOUD_PROJECT=your-google-cloud-project

# Recovery email: Render free blocks standard SMTP ports. Use HTTPS delivery.
# Set RESEND_API_KEY and a verified sender to enable the Resend backend automatically.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=HDFC Bank Student Project <noreply@your-verified-domain.example>
# Optional SMTP alternative for hosts that support it. Leave EMAIL_BACKEND blank for automatic selection.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0

# Deployment metadata for maintainers; these do not configure the application.
RENDER_API_URL=
RENDER_FRONTEND_URL=
RENDER_WORKSPACE_ID=
RENDER_API_SERVICE_ID=
RENDER_FRONTEND_SERVICE_ID=
RENDER_REGION=
AIVEN_PROJECT=
AIVEN_SERVICE=
AIVEN_REGION=
